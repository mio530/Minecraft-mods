# ---- RyzeSMP Test Client / AI remote-control config ----
# Copy to .env and fill in. NEVER commit the real .env.

# HTTP / dashboard
PORT=25571
HOST=0.0.0.0
PUBLIC_URL=https://test.ryzesmp.org

# Target server (RyzeSMP). Default is the Velocity public entrypoint.
MC_HOST=203.0.113.10
MC_PORT=25565
MC_VERSION=1.21.11
# microsoft = real online-mode account (default). offline = test backend only.
MC_AUTH=microsoft

# --- SECRETS: set strong unique values ---
# Signs dashboard login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Owner password for the web dashboard.
DASHBOARD_PASSWORD=change-me
# Bearer token every MCP client (Claude Code = primary, ChatGPT = optional) must send.
MCP_TOKEN=change-me-mcp-token
# Let the MCP client start/stop sessions autonomously (Claude Code as controller).
# Dangerous server commands still require owner approval regardless.
MCP_ALLOW_SESSIONS=true
# Where Microsoft OAuth *tokens* (never your password) are cached.
AUTH_CACHE_DIR=./.auth-cache

# Safety / limits
SESSION_TIMEOUT_MS=900000
MAX_SESSIONS=1
ACTION_RATE_PER_MIN=60
# safe = dangerous commands need owner approval. open = no approval gate.
SAFETY_MODE=safe
DANGEROUS_COMMANDS=/op,/stop,/ban,/deop,/whitelist,/pardon,/kick,/gamerule,/difficulty

# Optional real 3D renderer (needs native canvas+gl; off by default for performance)
VIEWER_ENABLED=false

LOG_LEVEL=info
DB_PATH=./data/ryze-test.db
