# ===== Discord =====
# Bot token from the Discord Developer Portal (Bot > Token)
DISCORD_TOKEN=
# Application (Client) ID
DISCORD_CLIENT_ID=
# Your server (guild) ID
DISCORD_GUILD_ID=

# ===== Channels (OPTIONAL) =====
# Leave these empty and run /suggestion setup in Discord — the bot creates the
# channels automatically and stores their IDs in the database. These variables
# are only a fallback if you want to point the bot at pre-existing channels.
# Forum channel where members submit suggestions (Channel A)
SUBMISSION_CHANNEL_ID=
# Text channel where voting messages are posted (Channel B)
VOTING_CHANNEL_ID=
# Private staff channel for logs (Channel C)
LOG_CHANNEL_ID=

# ===== Staff =====
# Comma-separated list of role IDs allowed to moderate
STAFF_ROLE_IDS=

# ===== AI =====
# Provider: openai | anthropic | none
# "none" disables AI and uses the deterministic fallback summarizer.
AI_PROVIDER=none
# API key for the chosen provider (never commit this)
AI_API_KEY=
# Model name, e.g. gpt-4o-mini (openai) or claude-haiku-4-5 (anthropic)
AI_MODEL=gpt-4o-mini
# Max AI requests per minute (rate limit guard)
AI_RATE_LIMIT_PER_MINUTE=10
# Similarity threshold (0-1) for duplicate detection
AI_SIMILARITY_THRESHOLD=0.82

# ===== Voting / Evaluation =====
# Auto-close voting after this many days (0 = never auto-close)
VOTING_DURATION_DAYS=7
# Minimum total votes considered meaningful in the evaluation summary
MINIMUM_VOTES=10
# Suggested minimum upvotes for a positive evaluation hint
MINIMUM_UPVOTES=5
# Suggested minimum positive ratio (0-100) for a positive evaluation hint
MINIMUM_POSITIVE_RATIO=60
# How often (minutes) to check for expired votings
EVALUATION_INTERVAL_MINUTES=15

# ===== Misc =====
# Path to the SQLite database file
DATABASE_PATH=./data/suggestions.db
# Prefix for suggestion IDs (e.g. RS -> RS-001)
SUGGESTION_ID_PREFIX=RS
# Log level: debug | info | warn | error
LOG_LEVEL=info
